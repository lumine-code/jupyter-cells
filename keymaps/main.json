{
  "lumine-workspace lumine-text-editor:not([mini]):not(lumine-dock lumine-text-editor)": {
    // Source-file execution shares the Jupyter prefix; Enter combinations stay
    // with ordinary editing, quick fixes, and opening external applications.
    "alt-j c r": "jupyter-cells:run-cell",
    "alt-j c s": "jupyter-cells:run-cell-and-move-down",
    "alt-j c a": "jupyter-cells:run-all"
  }
}
